#!/usr/bin/env bash
# website_dot_org: turn a directory tree of .org files into a static website.
#
# Every directory with .org files becomes a page whose header lists its pages,
# subdirectories, LINK_* files and URL symlinks: an `ls -a`-style terminal nav
# bar, or (NAV_STYLE=cards) a site bar plus a grid of picture cards on index
# pages. See README.md for the rules and website.conf options.
set -euo pipefail
shopt -s nullglob
export LC_COLLATE=C

SHARE=${WEBSITE_DOT_ORG_SHARE:-$(dirname "$(readlink -f "$0")")/../share}

usage() {
    echo "Usage: website_dot_org build [SRC=.] [OUT=build]" >&2
    exit 1
}

die() {
    echo "website_dot_org: $*" >&2
    exit 1
}

html_escape() {
    local s=$1
    s=${s//&/&amp;}; s=${s//</&lt;}; s=${s//>/&gt;}; s=${s//\"/&quot;}
    printf '%s' "$s"
}

is_url() { [[ $1 =~ ^https?:// ]]; }

# A git submodule checkout has a .git file instead of a .git directory.
is_submodule() { [[ -f $1/.git ]]; }

# org_keyword FILE KEY — print the value of the first "#+KEY: value" line.
org_keyword() {
    [[ -f $1 ]] || return 0
    sed -n "/^[[:space:]]*#+$2:/I{s/^[[:space:]]*#+$2:[[:space:]]*//I;s/[[:space:]]*\$//;p;q}" "$1"
}

# A page with "#+DRAFT: t" isn't rendered; cards show it greyed out.
is_draft() {
    local value
    value=$(org_keyword "$1" DRAFT)
    [[ ${value,,} =~ ^(t|true|yes)$ ]]
}

# Is path $1 (relative to SRC) left out of the site?
is_excluded() {
    local rel=$1 pat
    [[ /$rel == */.* || $rel == website.conf || $rel == "$HEAD_INCLUDE" ]] && return 0
    if [[ -n $OUT_REL ]] && [[ $rel == "$OUT_REL" || $rel == "$OUT_REL"/* ]]; then
        return 0
    fi
    for pat in "${EXCLUDE[@]}"; do
        # shellcheck disable=SC2053 # $pat is a glob on purpose
        if [[ $rel == $pat || $rel == $pat/* ]]; then
            return 0
        fi
    done
    return 1
}

# Nav entries of the directory being rendered. HREFs are relative to the
# site root (or absolute URLs); KEY identifies the page for underlining.
# TITLE, IMAGE and DRAFT come from the entry's org file, for cards.
NAV_KEY=() NAV_LABEL=() NAV_HREF=() NAV_KIND=() NAV_TITLE=() NAV_IMAGE=() NAV_DRAFT=()

# add_nav KEY LABEL HREF KIND [ORG_FILE]
# NAV_OVERRIDE[KEY]="target|label" replaces the entry's target and label.
add_nav() {
    local key=$1 label=$2 href=$3 kind=$4 org=${5:-} title="" image="" draft=""
    if [[ -v NAV_OVERRIDE[$key] ]]; then
        href=${NAV_OVERRIDE[$key]%%|*}
        label=${NAV_OVERRIDE[$key]#*|}
        if is_url "$href"; then kind=link; else kind=file; fi
    fi
    if [[ -n $org && -f $SRC/$org ]]; then
        title=$(org_keyword "$SRC/$org" CARD_TITLE)
        if [[ -z $title ]]; then title=$(org_keyword "$SRC/$org" TITLE); fi
        image=$(org_keyword "$SRC/$org" CARD_IMAGE)
        if [[ -n $image ]] && ! is_url "$image"; then
            image=$(realpath -m -s --relative-to="$SRC" "$SRC/$(dirname "$org")/$image")
        fi
        if is_draft "$SRC/$org"; then draft=1; fi
    fi
    NAV_KEY+=("$key") NAV_LABEL+=("$label") NAV_HREF+=("$href") NAV_KIND+=("$kind")
    NAV_TITLE+=("${title:-$label}") NAV_IMAGE+=("$image") NAV_DRAFT+=("$draft")
}

# collect_nav REL — fill the NAV_* arrays for directory SRC/REL.
collect_nav() {
    local rel=$1 dir=$SRC${1:+/$1} sub=${1:+$1/} path name target
    NAV_KEY=() NAV_LABEL=() NAV_HREF=() NAV_KIND=() NAV_TITLE=() NAV_IMAGE=() NAV_DRAFT=()

    for path in "$dir"/LINK_*; do
        name=${path##*/}
        if [[ -f $path ]] && ! is_excluded "$sub$name"; then
            target=$(head -n 1 "$path" | tr -d '\r\n')
            if [[ -n $target ]]; then
                add_nav "${name#LINK_}" "${name#LINK_}" "$target" link
            fi
        fi
    done

    for path in "$dir"/*.org; do
        name=${path##*/}
        name=${name%.org}
        if [[ $name != index ]] && ! is_excluded "$sub$name.org"; then
            add_nav "$name" "$name.org" "$sub$name.html" file "$sub$name.org"
        fi
    done

    for path in "$dir"/*; do
        name=${path##*/}
        if is_excluded "$sub$name"; then
            continue
        elif [[ -L $path ]]; then
            target=$(readlink "$path")
            if is_url "$target"; then
                add_nav "$name" "$name" "$target" link
            fi
        elif [[ -d $path ]]; then
            if is_submodule "$path"; then
                if [[ -f $path/README.org ]]; then
                    add_nav "$name/README.org" "$name/README.org" "$sub$name/README.html" file "$sub$name/README.org"
                fi
            elif compgen -G "$path/*.org" >/dev/null; then
                add_nav "$name" "$name" "$sub$name/index.html" dir "$sub$name/index.org"
            elif [[ -v NAV_OVERRIDE[$name] ]]; then
                add_nav "$name" "$name" "" dir
            fi
        fi
    done
}

# nav_order [drafts] — print the indices of the collected entries: names in
# NAV_ORDER first, in that order, then the rest sorted case-insensitively.
# Drafts are left out unless the argument is "drafts".
nav_order() {
    local i j rank
    for i in "${!NAV_KEY[@]}"; do
        if [[ -n ${NAV_DRAFT[$i]} && ${1:-} != drafts ]]; then continue; fi
        rank=${#NAV_ORDER[@]}
        for j in "${!NAV_ORDER[@]}"; do
            if [[ ${NAV_ORDER[$j]} == "${NAV_KEY[$i]}" || ${NAV_ORDER[$j]} == "${NAV_LABEL[$i]}" ]]; then
                rank=$j
                break
            fi
        done
        printf '%05d\t%s\t%s\n' "$rank" "${NAV_LABEL[$i]}" "$i"
    done | sort -f -t $'\t' -k1,1 -k2,2 | cut -f3
}

# write_nav CWD PREFIX CURRENT — print the terminal nav bar for the collected
# entries. CWD is the directory shown in the prompt, PREFIX the ../ path from
# the page to the site root, CURRENT the key of the page being rendered.
write_nav() {
    local cwd=$1 prefix=$2 current=$3 parent="" i width=0 href color style underline
    local -a order sorted keys=(. "${NAV_KEY[@]}") labels=(. "${NAV_LABEL[@]}")
    local -a hrefs=("${cwd:+$cwd/}index.html" "${NAV_HREF[@]}") kinds=(dir "${NAV_KIND[@]}")

    # Index 0 is ".", the last index is ".." (below root only), the rest ordered.
    mapfile -t sorted < <(nav_order)
    order=(0)
    if [[ -n $cwd ]]; then
        if [[ $cwd == */* ]]; then parent=${cwd%/*}/; fi
        order+=("${#keys[@]}")
        keys+=(..) labels+=(..) hrefs+=("${parent}index.html") kinds+=(dir)
    fi
    for i in "${sorted[@]}"; do order+=($((i + 1))); done

    for i in "${order[@]}"; do
        if (( ${#labels[$i]} > width )); then width=${#labels[$i]}; fi
    done
    width=$((width + 2))

    cat <<EOF
<div style="background: #232627; color: #ffffff; font-family: 'Ubuntu Sans Mono', monospace; font-size: 16px; padding: 8px; border-radius: 0; margin-bottom: 20px;">
<div style="margin-bottom: 10px;">guest@$(html_escape "$SITE_HOST"):$(html_escape "~${cwd:+/$cwd}")\$ echo LINKS: \$(ls -a)</div>
<div style="border-left: 4px solid #1d99f3; padding-left: 16px; display: grid; grid-template-columns: repeat(auto-fill, minmax(${width}ch, 1fr)); gap: 0;">LINKS:
EOF
    for i in "${order[@]}"; do
        href=${hrefs[$i]}
        if ! is_url "$href"; then href=$prefix$href; fi
        case ${kinds[$i]} in
            dir) color="#1d99f3" style="font-weight: bold;" ;;
            link) color="#1abc9c" style="font-weight: bold;" ;;
            *) color="#FFFFFF" style="" ;;
        esac
        underline="text-decoration: none;"
        if [[ ${keys[$i]} == "$current" ]]; then underline="text-decoration: underline;"; fi
        printf '<span style="white-space: pre;"><a href="%s" style="color: %s; %s %s">%s</a>%*s</span>\n' \
            "$(html_escape "$href")" "$color" "$style" "$underline" \
            "$(html_escape "${labels[$i]}")" $((width - ${#labels[$i]})) ""
    done
    echo '</div></div>'
}

# write_bar PREFIX — print the site bar of NAV_STYLE=cards.
write_bar() {
    local prefix=$1
    printf '<header class="wdo-bar"><a href="%sindex.html">' "$prefix"
    if [[ -n $SITE_LOGO ]]; then
        printf '<img src="%s" alt="" />' "$(html_escape "$prefix$SITE_LOGO")"
    fi
    printf '<span>%s</span></a></header>\n' "$(html_escape "$SITE_TITLE")"
}

# write_cards PREFIX — print the collected entries as a grid of picture cards.
write_cards() {
    local prefix=$1 i href image
    local -a order
    mapfile -t order < <(nav_order drafts)
    (( ${#order[@]} )) || return 0
    echo '<nav class="wdo-cards">'
    for i in "${order[@]}"; do
        href=${NAV_HREF[$i]}
        if [[ -n $href ]] && ! is_url "$href"; then href=$prefix$href; fi
        image=${NAV_IMAGE[$i]}
        if [[ -n $image ]] && ! is_url "$image"; then image=$prefix$image; fi
        if [[ -n ${NAV_DRAFT[$i]} || -z $href ]]; then
            printf '<div class="wdo-card wdo-draft">'
        else
            printf '<a class="wdo-card" href="%s">' "$(html_escape "$href")"
        fi
        if [[ -n $image ]]; then
            printf '<div class="wdo-card-img"><img src="%s" alt="" /></div>' "$(html_escape "$image")"
        fi
        printf '<div class="wdo-card-label">%s</div>' "$(html_escape "${NAV_TITLE[$i]}")"
        if [[ -n ${NAV_DRAFT[$i]} || -z $href ]]; then echo '</div>'; else echo '</a>'; fi
    done
    echo '</nav>'
}

# render SRC_FILE OUT_FILE CWD CURRENT — render one page with the nav of the
# collected entries. SRC_FILE may be /dev/null for a nav-only index.
render() {
    local src=$1 out=$2 cwd=$3 current=$4 page_dir prefix="" title
    local -a args

    page_dir=$(dirname "${out#"$OUT"/}")
    if [[ $page_dir != . ]]; then
        prefix=${page_dir//[!\/]/}/
        prefix=${prefix//\//..\/}
    fi

    args=(-f org -t html5 --standalone --template "$SHARE/template.html"
          --lua-filter "$SHARE/autolink.lua" --lua-filter "$SHARE/figure.lua" --katex
          --shift-heading-level-by=1 --include-before-body "$NAV_FILE"
          -V "root=$prefix" -V "content-width=$CONTENT_WIDTH" -V "build-id=$BUILD_ID")
    if [[ $NAV_STYLE == cards ]]; then
        write_bar "$prefix" >"$NAV_FILE"
        args+=(-V nav-cards=1)
        if [[ $current == . ]]; then
            write_cards "$prefix" >"$CARDS_FILE"
            args+=(--include-after-body "$CARDS_FILE")
        fi
    else
        write_nav "$cwd" "$prefix" "$current" >"$NAV_FILE"
    fi
    if [[ -n $HEAD_INCLUDE ]]; then
        sed "s|\\\$root\\\$|$prefix|g" "$SRC/$HEAD_INCLUDE" >"$HEAD_FILE"
        args+=(--include-in-header "$HEAD_FILE")
    fi
    if ! grep -qi '^[[:space:]]*#+title:' "$src"; then
        title=$(org_keyword "$src" CARD_TITLE)
        if [[ -z $title && $NAV_STYLE == cards ]]; then title=$SITE_TITLE; fi
        args+=(-M "pagetitle=${title:-~${cwd:+/$cwd}}")
    fi
    mkdir -p "$(dirname "$out")"
    (cd "$(dirname "$src")" && pandoc "${args[@]}" -o "$out" "$src")
}

# process_dir REL — render the pages of SRC/REL and recurse.
process_dir() {
    local rel=$1 dir=$SRC${1:+/$1} sub=${1:+$1/} path name key

    if [[ -z $rel ]] || compgen -G "$dir/*.org" >/dev/null; then
        collect_nav "$rel"
        for path in "$dir"/*.org; do
            name=${path##*/}
            name=${name%.org}
            if is_excluded "$sub$name.org" || is_draft "$path"; then continue; fi
            key=$name
            if [[ $name == index ]]; then key=.; fi
            render "$path" "$OUT/$sub$name.html" "$rel" "$key"
        done
        if [[ ! -f $dir/index.org ]]; then
            render /dev/null "$OUT/${sub}index.html" "$rel" .
        fi
        # Submodules are one page (their README.org) under the parent's nav.
        for path in "$dir"/*/; do
            path=${path%/}
            name=${path##*/}
            if ! is_excluded "$sub$name" && is_submodule "$path" && [[ -f $path/README.org ]]; then
                render "$path/README.org" "$OUT/$sub$name/README.html" "$rel" "$name/README.org"
            fi
        done
    fi

    for path in "$dir"/*/; do
        path=${path%/}
        name=${path##*/}
        if [[ ! -L $path ]] && ! is_excluded "$sub$name" && ! is_submodule "$path"; then
            process_dir "$sub$name"
        fi
    done
}

# Copy every file that isn't a page source into OUT, preserving paths.
copy_assets() {
    local path rel
    while IFS= read -r -d '' path; do
        rel=${path#"$SRC"/}
        case ${rel##*/} in *.org | LINK_*) continue ;; esac
        if is_excluded "$rel"; then continue; fi
        if [[ -L $path ]] && { is_url "$(readlink "$path")" || [[ ! -f $path ]]; }; then
            continue
        fi
        mkdir -p "$OUT/$(dirname "$rel")"
        cp -L "$path" "$OUT/$rel"
    done < <(find "$SRC" -mindepth 1 \( -name '.*' -o -path "$OUT" \) -prune -o \( -type f -o -type l \) -print0)
}

# Short hash of everything that feeds the build. Pages embed it and compare
# against version.txt, reloading themselves when a newer deploy is live.
build_id() {
    {
        (cd "$SRC" && find . -mindepth 1 \( -name '.*' -o -path "./${OUT_REL:-.}" \) -prune -o -type f -print0 \
            | sort -z | xargs -0 -r sha256sum)
        (cd "$SHARE" && find . -type f -print0 | sort -z | xargs -0 -r sha256sum)
        sha256sum <"$(readlink -f "$0")"
    } | sha256sum | cut -c1-12
}

[[ ${1:-} == build && $# -le 3 ]] || usage
SRC=$(realpath -e "${2:-.}")
OUT=$(realpath -m "${3:-build}")
if [[ $OUT == "$SRC" || $SRC == "$OUT"/* ]]; then
    die "OUT must not contain SRC"
fi
OUT_REL=""
if [[ $OUT == "$SRC"/* ]]; then OUT_REL=${OUT#"$SRC"/}; fi

SITE_HOST=""
SITE_TITLE=""
SITE_LOGO=""
NAV_STYLE=terminal
CONTENT_WIDTH=60em
HEAD_INCLUDE=""
declare -A NAV_OVERRIDE=()
NAV_ORDER=()
EXCLUDE=()
if [[ -f $SRC/website.conf ]]; then
    # shellcheck source=/dev/null
    source "$SRC/website.conf"
fi
if [[ -z $SITE_HOST ]]; then
    if [[ -f $SRC/CNAME ]]; then
        SITE_HOST=$(head -n 1 "$SRC/CNAME" | tr -d '\r\n')
    else
        SITE_HOST=${SRC##*/}
    fi
fi
SITE_TITLE=${SITE_TITLE:-$SITE_HOST}
[[ $NAV_STYLE == terminal || $NAV_STYLE == cards ]] || die "NAV_STYLE must be terminal or cards"
[[ -z $HEAD_INCLUDE || -f $SRC/$HEAD_INCLUDE ]] || die "HEAD_INCLUDE $HEAD_INCLUDE not found"

NAV_FILE=$(mktemp)
CARDS_FILE=$(mktemp)
HEAD_FILE=$(mktemp)
trap 'rm -f "$NAV_FILE" "$CARDS_FILE" "$HEAD_FILE"' EXIT

BUILD_ID=$(build_id)
rm -rf "$OUT"
mkdir -p "$OUT"
copy_assets
echo "$BUILD_ID" >"$OUT/version.txt"
if [[ ! -f $OUT/typography.css ]]; then cp "$SHARE/typography.css" "$OUT/"; fi
process_dir ""
echo "Build complete. Output in $OUT/"
